# Copiá este archivo como .env y llenalo.

# Dominio gratis de Azure (etiqueta DNS de la IP pública de la VM)
DOMINIO=multiplanet-mcp.eastus.cloudapp.azure.com

# Secreto largo: forma parte de las URLs. Generalo con:
#   python3 -c "import secrets;print(secrets.token_urlsafe(32))"
MCP_SECRET=

# Lo da obtener_token.py
FB_PAGE_ID=
FB_PAGE_TOKEN=
# Segunda página (opcional): Multiplanet Floristería
FB_PAGE_ID_FLORISTERIA=
FB_PAGE_TOKEN_FLORISTERIA=

# Opcionales
ZONA_HORARIA=America/Tegucigalpa
FB_GRAPH_VERSION=v27.0
# FB_DRY_RUN=1   # simula todo sin tocar Facebook

# URL de la web; usa el MCP_SECRET existente para conectarse.
CATALOGO_URL=https://tu-sitio.example
# Opcional si configuraste una CATALOG_API_KEY distinta en la web:
# CATALOGO_API_KEY=
# Solo si usás un dominio propio para Supabase Storage:
# CATALOGO_MEDIA_HOST=storage.tu-dominio.example
DATA_DIR=./data
